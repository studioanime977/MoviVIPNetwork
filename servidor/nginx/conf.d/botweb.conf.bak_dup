# MoviVIP — CONFIG DUPLICADA (RESPALDO DEL PROBLEMA)
#
# Este archivo ES EL BACKUP de la config que causaba el conflicto.
# Fue creado en /etc/nginx/conf.d/botweb.conf el 2026-09-01 19:30 (cuando se toco xray)
# y DUPLICABA el server de la mini app que ya existia en sites-enabled/movivip-miniapp.
#
# CONSECUENCIA: al reiniciar nginx, no podia bind() al puerto 127.0.0.1:4432
#   (ya ocupado) + generaba warning "conflicting server name".
#   -> nginx.service quedaba en 'failed' y la mini app dependia de procesos heredados.
#
# FIX APLICADO 2026-09-02:
#   mv /etc/nginx/conf.d/botweb.conf /etc/nginx/conf.d/botweb.conf.bak_dup
#   -> nginx -t OK -> nginx arranco bajo systemd (enabled + active).
#
# SE MANTIENE AQUI SOLO COMO REGISTRO. NO VOLVER A ACTIVARLO:
#   la config correcta es /etc/nginx/sites-available/movivip-miniapp (unica).

server {
    listen 127.0.0.1:4432 ssl http2;
    server_name bot.movivipoppax.uk;

    ssl_certificate /etc/letsencrypt/live/bot-movivipoppax.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot-movivipoppax.uk/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    location / {
        proxy_pass http://127.0.0.1:5081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
