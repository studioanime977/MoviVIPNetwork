[Unit]
Description=MoviVIP Bot Generador de Licencias
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/movivip
ExecStart=/bin/bash /etc/movivip/herramientas/bot-generador.sh
Restart=always
RestartSec=10
Environment=MOVIVIP_BOT_TOKEN=TU_TOKEN_DEL_BOT_AQUI
Environment=MOVIVIP_MASTER_KEY=TU_MASTER_KEY_AQUI

# Seguridad
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=movivip-bot-generador

[Install]
WantedBy=multi-user.target
